# ==============================================================================
# TEMPLATE KONFIGURASI .ENV KHUSUS PRODUCTION / CPANEL SHARED HOSTING
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi ".env" di File Manager cPanel Anda.
# 2. Isi kredensial database yang Anda buat di menu "MySQL Databases" cPanel.
# 3. Pastikan APP_DEBUG=false agar pesan error sistem tidak membocorkan struktur kode.
# 4. Pastikan APP_URL menggunakan https://
# ==============================================================================

APP_NAME="Absensi Guru"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://absensi.sekolahanda.sch.id
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Pengaturan Log Ringan untuk Shared Hosting (Otomatis rotasi harian agar hemat kuota hosting)
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_MAX_FILES=7

# Kredensial Database MySQL cPanel (Buat di cPanel > MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usernamecpanel_absensi
DB_USERNAME=usernamecpanel_dbuser
DB_PASSWORD=PasswordDatabaseKuat123!

# Keamanan Sesi Pengguna
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Penyimpanan Berkas & Cache
FILESYSTEM_DISK=public
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Pengaturan Mail / Notifikasi (Opsional: sesuaikan dengan SMTP cPanel / webmail)
MAIL_MAILER=smtp
MAIL_HOST=mail.sekolahanda.sch.id
MAIL_PORT=465
MAIL_USERNAME=admin@sekolahanda.sch.id
MAIL_PASSWORD=PasswordEmailHosting
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@sekolahanda.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
